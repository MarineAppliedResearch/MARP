# MARP umbrella repository.
#
# This repository is the workspace root for the MARP ecosystem. Each component
# is cloned as a subdirectory here but remains its own independent Git
# repository, so every component directory must stay ignored. Without this, the
# umbrella would try to absorb them, including roughly 93 MB of marp-jellyfin,
# and a commit here would carry a component's files or a stray gitlink with it.
#
# Keep this list in sync with services/repos.yml. `scripts/marp doctor` checks
# that they agree and fails if a registered directory is not ignored here.

# --- Component repositories (each is its own Git repository) ---
/MARP_API/
/marp-jellyfin/
/marp-inference-worker/
/marp-video-player/

# --- Related repositories (in the workspace, not part of a deployment) ---
/VIDEO_PROCESSING_GUI/

# --- Former directory names, kept so a part-migrated checkout stays safe ---
/MARE_API/

# --- Local workspace state ---
.vscode/settings.json
*.local
*.log

# --- OS noise ---
Thumbs.db
desktop.ini
.DS_Store

# --- Python (legacy/ scripts and any tooling that lands here) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# --- Node (if ecosystem tooling lands here) ---
node_modules/

# --- Environment files: never commit real configuration ---
.env
.env.*
!.env.example
